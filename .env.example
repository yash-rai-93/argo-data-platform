# Copy to .env; uv run --env-file .env loads it for local commands.
# BigQuery is needed only to rebuild the historical dataset.
GOOGLE_CLOUD_PROJECT=
BIGQUERY_LOCATION=US
# Required for an actual extraction; set after reviewing the dry-run estimate.
BIGQUERY_MAX_BYTES_BILLED=

# Optional: both are required to enable live OpenRouter summaries.
# With either empty, the API generates a summary from stored cohort metrics.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
