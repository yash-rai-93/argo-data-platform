# Normalize line endings: LF in the repo, checked out as-is per .editorconfig.
* text=auto eol=lf

# Windows-native scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets — never diffed or line-ending converted.
*.png binary
*.jpg binary
*.parquet binary
*.duckdb binary
*.pbix binary
*.twbx binary

# Keep generated lockfiles out of language stats and diffs.
uv.lock linguist-generated=true
