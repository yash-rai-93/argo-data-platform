# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual environments / uv
.venv/
uv.lock.bak

# Environment & secrets
.env
.env.*
!.env.example
*.pem
secrets/
gha-creds-*.json

# ML artifacts. The trained boosters are tracked on purpose: they are the
# deliverable, and without them a fresh clone cannot serve a prediction or
# build the Docker image.
ml/models/*.json
!ml/models/*.json

# dbt
target/
dbt_packages/
logs/
.dbt/
.user.yml

# Internal planning notes (not part of the public portfolio)
Argo_Summary.md

# Data artifacts. Everything here is public GitHub Archive data, so the built
# warehouse is committed to make the repo clone-and-run. Any other .duckdb file
# stays ignored.
*.duckdb
!transform/argo.duckdb
*.sqlite
*.parquet
data/raw/
data/generated/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
